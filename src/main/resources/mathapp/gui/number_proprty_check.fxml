<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="mathapp.gui.NumberPropertiesController" spacing="18" alignment="TOP_CENTER" styleClass="screen-card">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- Title -->
    <Label text="Number Properties Check" styleClass="title-text"/>

    <!-- Property Selection Dropdown -->
    <VBox spacing="8" fillWidth="true">
        <Label text="Select Property to Check:" styleClass="body-text"/>
        <ComboBox fx:id="propertyCombo" maxWidth="Infinity" prefHeight="40"/>
    </VBox>

    <Separator/>

    <!-- Input Section -->
    <VBox spacing="8" fillWidth="true">
        <Label text="Enter Number(s):" styleClass="body-text"/>
        <Label text="Single number for: Even, Odd, Positive, Negative, Prime, Factors" style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>
        <Label text="Comma-separated list for: Natural, Whole, Rational, HCF, LCM, Counts" style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>
        <TextField fx:id="inputField" promptText="e.g. 12 or 12, 18, 24" prefHeight="50" styleClass="display-field"/>
    </VBox>

    <!-- Action Buttons -->
    <HBox spacing="12" alignment="CENTER">
        <Button fx:id="actionCheckButton" text="Check" prefWidth="160" prefHeight="50" onAction="#handleCheck" styleClass="btn-primary"/>
        <Button fx:id="actionClearButton" text="Clear" prefWidth="160" prefHeight="50" onAction="#handleClear" styleClass="clear-button"/>
    </HBox>

    <Separator/>

    <!-- Result Section -->
    <VBox spacing="8" fillWidth="true" VBox.vgrow="ALWAYS">
        <Label text="Result:" styleClass="body-text"/>
        <TextArea fx:id="resultArea" editable="false" wrapText="true" promptText="Result will appear here..." VBox.vgrow="ALWAYS" prefHeight="200" styleClass="display-field"/>

    </VBox>

</VBox>

