<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mathapp.gui.pages.sequanceSeries.SequenceSolverController"
      spacing="15"
      styleClass="screen-card">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Header Section -->
    <VBox spacing="5">
        <Label text="Patterns, Sequences &amp; Series Solver" styleClass="title-text"/>
        <Label text="Detect underlying patterns, compute difference tables, find n-th term formulas, or generate special sequences." 
               wrapText="true" styleClass="body-text"/>
    </VBox>

    <Separator/>

    <!-- Operations & Modes Grid -->
    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="160"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Operation Selection -->
        <Label text="Sequence / Series Operation:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="body-text"/>
        <ComboBox fx:id="operationComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Select Operation..."/>

        <!-- Sequence Input Field -->
        <Label fx:id="inputLabel" text="Sequence Input:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="body-text"/>
        <TextField fx:id="sequenceInputField" promptText="e.g., 2, 5, 10, 17, 26" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

         <Label fx:id="termIndexLabel" text="Target term n:" visible="false" managed="false"
             GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="body-text"/>
         <TextField fx:id="termIndexField" promptText="e.g., 10" visible="false" managed="false"
                 GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="actionAnalyzeButton" text="Analyze / Calculate" onAction="#handleAnalyzeSequence" styleClass="btn-primary"/>
        <Button text="Load Sample Sequence" onAction="#handleLoadSample" styleClass="btn-primary"/>
        <Button text="Clear" onAction="#handleClear" styleClass="btn-primary"/>
    </HBox>

    <!-- Results Area -->
    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <Label text="Analysis &amp; Formula Output:" styleClass="body-text"/>
        <TextArea fx:id="outputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
    </VBox>

</VBox>