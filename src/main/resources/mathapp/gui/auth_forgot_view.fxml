<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" spacing="12" alignment="CENTER" styleClass="screen-card" maxWidth="500" minWidth="300">


    <children>
        <Label styleClass="auth-title" text="Forgot Password" />
        <Label styleClass="auth-subtitle" text="Enter your email to receive a reset link" />

        <Label styleClass="field-label" text="Email" />
        <TextField fx:id="forgotEmail" promptText="Enter your registered email" styleClass="text-field" />

        <Label fx:id="forgotEmailError" styleClass="error-label" text="" managed="false" />

        <HBox spacing="10.0" styleClass="action-button-row">
            <Button onAction="#handleForgotPassword" styleClass="btn-primary" text="Send Reset Link" />
            <Button onAction="#showLogin" styleClass="btn-nav" text="Back to Login" />
        </HBox>

        <Label fx:id="forgotMessage" styleClass="auth-message" text="" wrapText="true" />

        <Label styleClass="auth-footer" text="Math Solver Pro v2.0" />
    </children>

</VBox>

