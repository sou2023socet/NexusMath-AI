<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" spacing="12" alignment="CENTER" styleClass="screen-card" maxWidth="500" minWidth="300">
    <children>
        <Label styleClass="auth-title" text="Login" />
        <Label styleClass="auth-subtitle" text="Sign in to access all features" />

        <Label styleClass="field-label" text="Email" />
        <TextField fx:id="loginEmail" promptText="Enter your email" styleClass="text-field" />

        <Label styleClass="field-label" text="Password" />
        <HBox spacing="0" styleClass="password-field-wrapper" alignment="CENTER_LEFT">
            <PasswordField fx:id="loginPassword" promptText="Enter your password" HBox.hgrow="ALWAYS" styleClass="password-field-base" />
            <Button fx:id="loginPasswordToggle" text="👁" styleClass="password-toggle-btn" onAction="#handleLoginPasswordToggle" />
        </HBox>

        <Label fx:id="loginEmailError" styleClass="error-label" text="" managed="false" />
        <Label fx:id="loginPasswordError" styleClass="error-label" text="" managed="false" />

        <HBox spacing="10.0" styleClass="action-button-row">
            <Button fx:id="loginButton" onAction="#handleLogin" styleClass="btn-primary" text="Login" />
            <Button onAction="#showRegistration" styleClass="btn-nav" text="Create Account" />
        </HBox>

        <Button onAction="#showForgotPassword" styleClass="btn-nav" text="Forgot Password?" />

        <Label fx:id="loginMessage" styleClass="auth-message" text="" wrapText="true" />

        <Label styleClass="auth-footer" text="Math Solver Pro v2.0" />
    </children>

</VBox>

