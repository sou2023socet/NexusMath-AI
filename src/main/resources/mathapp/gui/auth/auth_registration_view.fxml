<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" spacing="12" alignment="CENTER" styleClass="screen-card" maxWidth="500" minWidth="300">

    <children>
        <Label styleClass="auth-title" text="Registration" />
        <Label styleClass="auth-subtitle" text="Create a new account" />

        <Label styleClass="field-label" text="Email" />
        <TextField fx:id="regEmail" promptText="Enter your email" styleClass="text-field" />

        <Label styleClass="field-label" text="Username" />
        <TextField fx:id="regUsername" promptText="Choose a username" styleClass="text-field" />

        <Label styleClass="field-label" text="Password" />
        <HBox spacing="0" styleClass="password-field-wrapper" alignment="CENTER_LEFT">
            <PasswordField fx:id="regPassword" promptText="Choose a password" HBox.hgrow="ALWAYS" styleClass="password-field-base" />
            <Button fx:id="regPasswordToggle" text="👁" styleClass="password-toggle-btn" onAction="#handleRegPasswordToggle" />
        </HBox>

        <Label fx:id="regEmailError" styleClass="error-label" text="" managed="false" />
        <Label fx:id="regUsernameError" styleClass="error-label" text="" managed="false" />
        <Label fx:id="regPasswordError" styleClass="error-label" text="" managed="false" />

        <HBox spacing="10.0" styleClass="action-button-row">
            <Button fx:id="regButton" onAction="#handleRegistration" styleClass="btn-primary" text="Register" />
            <Button onAction="#showLogin" styleClass="btn-nav" text="Back to Login" />
        </HBox>

        <Label fx:id="regMessage" styleClass="auth-message" text="" wrapText="true" />

        <Label styleClass="auth-footer" text="Math Solver Pro v2.0" />
    </children>

</VBox>

