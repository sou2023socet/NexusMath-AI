<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================= -->
    <!-- Project Information                                       -->
    <!-- ========================================================= -->

    <groupId>mathapp</groupId>
    <artifactId>scientific-computing-workbench</artifactId>
    <version>1.0.0</version>


    <!-- ========================================================= -->
    <!-- Properties                                                -->
    <!-- ========================================================= -->

    <properties>

        <!-- Java -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Encoding -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- JavaFX -->
        <javafx.version>21.0.2</javafx.version>

        <!-- JUnit -->
        <junit.version>5.10.2</junit.version>

    </properties>


    <!-- ========================================================= -->
    <!-- Dependencies                                              -->
    <!-- ========================================================= -->

    <dependencies>

        <!-- ===================================================== -->
        <!-- JavaFX                                                 -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>


        <!-- ===================================================== -->
        <!-- JUnit                                                   -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <!-- ========================================================= -->
    <!-- Build                                                     -->
    <!-- ========================================================= -->

    <build>
        <plugins>


            <!-- ================================================= -->
            <!-- 1. Maven Compiler                                 -->
            <!-- ================================================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <excludes><exclude>**/*Test.java</exclude></excludes>
                </configuration>
            </plugin>


            <!-- ================================================= -->
            <!-- 2. Copy JavaFX Runtime Dependencies               -->
            <!--                                                     -->
            <!-- JavaFX remains outside the application JAR.       -->
            <!-- This is important because the project is          -->
            <!-- non-modular.                                      -->
            <!-- ================================================= -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>

                <executions>

                    <execution>

                        <id>copy-javafx-dependencies</id>

                        <phase>prepare-package</phase>

                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>

                        <configuration>

                            <outputDirectory>
                                ${project.build.directory}/jpackage-input
                            </outputDirectory>

                            <includeScope>
                                runtime
                            </includeScope>

                            <excludeTransitive>
                                false
                            </excludeTransitive>

                        </configuration>

                    </execution>

                </executions>

            </plugin>


            <!-- ================================================= -->
            <!-- 3. Prepare jpackage Input Directory               -->
            <!-- ================================================= -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>

                <executions>

                    <execution>

                        <id>prepare-jpackage-input</id>

                        <phase>package</phase>

                        <goals>
                            <goal>run</goal>
                        </goals>

                        <configuration>

                            <target>

                                <!-- Create jpackage input directory -->

                                <mkdir
                                    dir="${project.build.directory}/jpackage-input"/>


                                <!-- Copy application JAR -->

                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                    todir="${project.build.directory}/jpackage-input"/>

                            </target>

                        </configuration>

                    </execution>

                </executions>

            </plugin>


            <!-- ================================================= -->
            <!-- 4. jpackage                                       -->
            <!-- ================================================= -->

            <plugin>

                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.8.0</version>

                <configuration>

                    <!-- ================================================= -->
                    <!-- Application                                      -->
                    <!-- ================================================= -->

                    <name>NexusMathAI</name>

                    <appVersion>${project.version}</appVersion>

                    <vendor>MathApp</vendor>

                    <description>NexusMath-AI Scientific Computing Workbench</description>

                    <copyright>Copyright 2026 MathApp</copyright>


                    <!-- ================================================= -->
                    <!-- Application Input                                 -->
                    <!-- ================================================= -->

                    <input>${project.build.directory}/jpackage-input</input>

                    <mainJar>${project.build.finalName}.jar</mainJar>

                    <mainClass>mathapp.gui.MainGUIApp</mainClass>


                    <!-- ================================================= -->
                    <!-- JavaFX Runtime                                    -->
                    <!-- ================================================= -->

                    <javaOptions>
                        <javaOption>--module-path $APPDIR</javaOption>
                        <javaOption>--add-modules javafx.controls,javafx.fxml</javaOption>
                    </javaOptions>


                    <!-- ================================================= -->
                    <!-- Output                                            -->
                    <!-- ================================================= -->

                    <destination>${project.build.directory}/installer</destination>

                    <removeDestination>true</removeDestination>

                    <!-- ================================================= -->
                    <!-- Windows                                           -->
                    <!-- ================================================= -->

                    <type>EXE</type>

                    <winMenu>true</winMenu>

                    <winShortcut>true</winShortcut>

                    <winDirChooser>true</winDirChooser>

                </configuration>

                <executions>
                    <execution>
                        <id>package-exe</id>
                        <phase>package</phase>
                        <goals><goal>jpackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>